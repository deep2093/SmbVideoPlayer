+struct vs_plane_ref {
+    const VSAPI *api;
+    const VSFrame *frame;
+    VSNode *keep_core;
+};
+
+static void release_vs_plane(void *opaque, uint8_t *data)
+{
+    (void)data;
+    struct vs_plane_ref *ref = opaque;
+    // Free the frame before the node that keeps its core alive. VapourSynth R73
+    // deletes the core's frame memory tracker when the core is destroyed, and
+    // that races with a frame freed on another thread at the same moment.
+    ref->api->freeFrame(ref->frame);
+    ref->api->freeNode(ref->keep_core);
+    free(ref);
+}
+
+static struct mp_image *reference_vs_output(const VSAPI *api, VSNode *keep_core,
+                                            const VSFrame *frame, struct mp_image *source)
+{
+    struct mp_image *image = mp_image_new_dummy_ref(NULL);
+    mp_image_setfmt(image, source->imgfmt);
+    mp_image_set_size(image, source->w, source->h);
+    for (int plane = 0; plane < image->num_planes; plane++) {
+        ptrdiff_t stride = source->stride[plane];
+        int height = api->getFrameHeight(frame, plane);
+        if (!source->planes[plane] || stride <= 0 || height <= 0 ||
+            (size_t)stride > SIZE_MAX / (size_t)height) {
+            talloc_free(image);
+            return NULL;
+        }
+
+        // Each AVBuffer accounts for its own plane, including when forwarded
+        // to a libavfilter. The read-only flag preserves copy-on-write.
+        struct vs_plane_ref *ref = malloc(sizeof(*ref));
+        if (!ref) {
+            talloc_free(image);
+            return NULL;
+        }
+        ref->api = api;
+        ref->frame = api->addFrameRef(frame);
+        ref->keep_core = api->addNodeRef(keep_core);
+        image->bufs[plane] = av_buffer_create(source->planes[plane],
+            (size_t)stride * (size_t)height, release_vs_plane, ref,
+            AV_BUFFER_FLAG_READONLY);
+        if (!image->bufs[plane]) {
+            release_vs_plane(ref, NULL);
+            talloc_free(image);
+            return NULL;
+        }
+        image->planes[plane] = source->planes[plane];
+        image->stride[plane] = stride;
+    }
+    mp_image_copy_attributes(image, source);
+    return image;
+}
+
+// A node no one reads from. While shared planes hold it, the core outlives the
+// script, so the core is destroyed only after the last shared frame is freed.
+static const VSFrame *VS_CC keep_core_get_frame(int n, int activationReason,
+                                                 void *instanceData, void **frameData,
+                                                 VSFrameContext *frameCtx, VSCore *core,
+                                                 const VSAPI *vsapi)
+{
+    (void)n;
+    (void)instanceData;
+    (void)frameData;
+    (void)core;
+    if (activationReason == arInitial)
+        vsapi->setFilterError("The core keep-alive node has no frames", frameCtx);
+    return NULL;
+}
