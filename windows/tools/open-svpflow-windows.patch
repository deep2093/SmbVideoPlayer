+
+/// Optional process-local vendor filter for hybrid Windows laptops.
+/// An explicit selection never silently switches to another vendor.
+pub unsafe fn device_matches_vendor(cl: &OpenCl, device: Handle) -> bool {
+    let wanted = std::env::var("SKYWING_OPENCL_VENDOR").unwrap_or_default();
+    let wanted = wanted.trim().to_ascii_lowercase();
+    if wanted.is_empty() { return true; }
+    let mut bytes = [0u8; 256];
+    let rc = unsafe { (cl.GetDeviceInfo)(device, 0x102C, bytes.len(), bytes.as_mut_ptr().cast(), std::ptr::null_mut()) };
+    if rc != CL_SUCCESS { return false; }
+    let end = bytes.iter().position(|b| *b == 0).unwrap_or(bytes.len());
+    String::from_utf8_lossy(&bytes[..end]).to_ascii_lowercase().contains(&wanted)
+}
