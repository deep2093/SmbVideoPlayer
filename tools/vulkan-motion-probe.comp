#version 450
// Independent diagnostic: known-motion compensation, not motion estimation.
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) readonly buffer SourceA { uint a[]; };
layout(set=0,binding=1,std430) readonly buffer SourceB { uint b[]; };
layout(set=0,binding=2,std430) writeonly buffer Output { uint result[]; };
layout(push_constant) uniform Params { uint width; uint height; int dx; int dy; uint phase; } p;
void main() {
    uint i=gl_GlobalInvocationID.x, area=p.width*p.height;
    if(i>=area*3/2) return;
    uint offset=0, w=p.width, h=p.height;
    int dx=p.dx, dy=p.dy;
    if(i>=area) {
        offset=area+(i>=area+area/4 ? area/4 : 0);
        w/=2; h/=2; dx/=2; dy/=2;
    }
    ivec2 xy=ivec2((i-offset)%w,(i-offset)/w), limit=ivec2(w-1,h-1);
    ivec2 delta=ivec2(dx,dy);
    ivec2 first=clamp(xy-delta*int(p.phase)/256,ivec2(0),limit);
    ivec2 second=clamp(xy+delta*int(256-p.phase)/256,ivec2(0),limit);
    uint v0=a[offset+uint(first.y)*w+uint(first.x)];
    uint v1=b[offset+uint(second.y)*w+uint(second.x)];
    result[i]=(v0*(256-p.phase)+v1*p.phase+128)/256;
}
