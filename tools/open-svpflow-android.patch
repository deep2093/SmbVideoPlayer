diff --git a/crates/svpflow-host/src/opencl.rs b/crates/svpflow-host/src/opencl.rs
index ebd6ba4..f77dd21 100644
--- a/crates/svpflow-host/src/opencl.rs
+++ b/crates/svpflow-host/src/opencl.rs
@@ -194,6 +194,8 @@ impl OpenCl {
             "OpenCL.dll"
         } else if cfg!(target_os = "macos") {
             "/System/Library/Frameworks/OpenCL.framework/OpenCL"
+        } else if cfg!(target_os = "android") {
+            "libOpenCL.so"
         } else {
