<?xml version="1.0" encoding="utf-8"?>
<!--
  The app already sets allowBackup="false". These rules make that explicit for Android 12+
  device-to-device transfer as well, so WireGuard configuration (which contains a private key)
  and VPN preferences are never copied off the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
