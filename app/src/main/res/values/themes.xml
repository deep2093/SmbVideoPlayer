<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="launch_background">#11192A</color>

    <style name="Theme.VideoLibrary" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Shown while the app starts: the icon on the launch colour, then the opening animation takes over. -->
    <style name="Theme.VideoLibrary.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.VideoLibrary</item>
    </style>
</resources>
